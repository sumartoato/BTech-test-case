# Docker db service is published on host port 5434 (see docker-compose.yml DB_PORT)
DATABASE_URL=postgresql://wallet:wallet@localhost:5434/wallet?schema=public
JWT_SECRET=DeveloperSecretKey
JWT_EXPIRES_IN=15m
INITIAL_BALANCE=1000000
PORT=3000
# Swagger UI at /api/docs. Leave empty to follow NODE_ENV (off when NODE_ENV=production).
# Set true/false to force it on or off.
SWAGGER_ENABLED=TRUE
